# Sarvam cloud: speech-to-text + text-to-speech (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
# Order parser: llama (Sarvam 30B on llama-server) | ollama | sarvam (cloud) | rules (no model). Defaults: llama if LLAMA_URL set, else ollama if OLLAMA_URL set, else rules.
PARSER=
LLAMA_URL=http://<gpu-host>:18080
LLAMA_KEY=
OLLAMA_URL=http://<gpu-host>:11434
OLLAMA_MODEL=qwen3.8:27b
# mock (default, "simulate payment" button) or paytm (needs MID/key from Paytm)
PAYMENT_MODE=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_POS_ID=S1_1
PAYTM_HOST=https://securestage.paytmpayments.com
# language the kitchen "new order" text defaults to (en-IN | hi-IN | te-IN); chefs have their own language in Owner → Kitchen setup
KITCHEN_LANG=en-IN
PORT=3000

# Phone orders (calls forwarded to a telephony number are streamed to ws://host:VOICE_PORT/voice?shop=<shop code>&key=<VOICE_KEY>).
# Calls are refused unless VOICE_KEY is set. VOICE_PORT (optional) serves only /voice on its own port, so a public tunnel exposes nothing else.
VOICE_KEY=
# Phone orders are tied to these shop codes only (comma separated; empty = any shop). PHONE_AGENT_NUMBER is the number owners forward calls to.
VOICE_SHOPS=
PHONE_AGENT_NUMBER=
VOICE_PORT=
# Pickup times ("at six thirty") are read in the server's timezone
TZ=Asia/Kolkata

# Pay-first phone orders: the customer gets an SMS with a pay link (PUBLIC_URL + /pay/<token>). SMS_PROVIDER=mock only logs the message
# (owners can read it at GET /api/phone/sms); SMS_PROVIDER=exotel needs EXOTEL_SID, EXOTEL_API_KEY, EXOTEL_API_TOKEN, EXOTEL_SENDER (a DLT sender id)
# EXOTEL_HOST (api.exotel.com or api.in.exotel.com, as shown in your dashboard), EXOTEL_DLT_ENTITY_ID, EXOTEL_DLT_TEMPLATE_ID and, in India, SMS_PAY_TEMPLATE set to your DLT-approved text with {shop} {total} {number} {time} {link}. Unpaid phone orders cancel after PAY_TTL_MIN (15).
PUBLIC_URL=
SMS_PROVIDER=mock
PAY_TTL_MIN=15
# only for SMS_PROVIDER=exotel
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SENDER=
# EXOTEL_HOST=api.exotel.com
# EXOTEL_DLT_ENTITY_ID=
# EXOTEL_DLT_TEMPLATE_ID=
# SMS_PAY_TEMPLATE=
# link = text the caller a pay link instead of paying at pickup
# PHONE_PAY=link
# minutes before pickup that a phone order starts cooking
# PHONE_LEAD_MIN=30

# Shops. TENANCY=multi serves many shops (join with a shop code); unset = one shop, whose type is SHOP (canteen | tiffin | restaurant | kirana)
# TENANCY=multi
# SHOP=canteen
# invite key needed to create a shop (unset = anyone can), and new shops allowed per hour per address
# SIGNUP_KEY=
# SIGNUPS_PER_HOUR=10
# set to enable the admin API (x-admin-key header)
# ADMIN_KEY=
# signs login tokens (unset = generated once into the data folder)
# TOKEN_SECRET=
# set when behind a reverse proxy, to read the client address from X-Forwarded-For
# TRUST_PROXY=1
# where orders and shops are saved (default ./data; Docker sets this itself)
# DATA_DIR=
# unload a shop from memory after this long without use, in milliseconds
# TENANT_IDLE_MS=900000

# Per-shop daily limits
# LIMIT_STT_DAY=3000
# LIMIT_TTS_CHARS_DAY=200000
# LIMIT_LLM_DAY=3000

# Language model used by the owner copilot (llama | ollama | sarvam; default follows LLAMA_URL / OLLAMA_URL / SARVAM_API_KEY)
# COPILOT_LLM=
# LLM_CONCURRENCY=8
# LLM_QUEUE=64
# LLM_TIMEOUT_MS=12000
# Bulbul voice for spoken replies (default: Sarvam's own)
# TTS_SPEAKER=
